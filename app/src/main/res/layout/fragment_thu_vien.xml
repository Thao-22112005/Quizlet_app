<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F7FA">

    <!-- TIÊU ĐỀ -->

    <TextView
        android:id="@+id/tvLibraryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="THƯ VIỆN"
        android:textColor="#263238"
        android:textSize="26sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAddVocabulary" />


    <!-- NÚT TẠO BỘ TỪ -->

    <ImageButton
        android:id="@+id/btnAddVocabulary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_add"
        android:paddingBottom="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Tạo bộ từ"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- TÌM KIẾM -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Tìm kiếm bộ từ"
        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/btnAddVocabulary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="7dp"
            android:inputType="text"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- DANH SÁCH BỘ TỪ -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVocabularySet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"

        app:layout_constraintTop_toBottomOf="@id/tilSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- KHÔNG CÓ DỮ LIỆU -->

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có bộ từ nào"
        android:textColor="#757575"
        android:textSize="16sp"
        android:visibility="gone"

        app:layout_constraintTop_toTopOf="@id/recyclerVocabularySet"
        app:layout_constraintBottom_toBottomOf="@id/recyclerVocabularySet"
        app:layout_constraintStart_toStartOf="@id/recyclerVocabularySet"
        app:layout_constraintEnd_toEndOf="@id/recyclerVocabularySet" />

</androidx.constraintlayout.widget.ConstraintLayout>